PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cp_sync
NODE_ENV=development

# Required for CLIST aggregate coverage (including Meta / HackerCup)
CLIST_USERNAME=
CLIST_API_KEY=

# Optional admin-only manual contest refresh key (never put in the extension)
CONTEST_SYNC_KEY=

# Exact number of trusted reverse-proxy hops; leave 0 for direct connections.
# Set to the actual hosting topology so rate limits use the correct client IP.
TRUST_PROXY_HOPS=0

# Optional consent-based public profiles (requires MongoDB).
PROFILE_SHARING_ENABLED=false
# Generate a private 32-byte random key; never put it in the extension or GitHub.
PROFILE_ADMIN_KEY=
